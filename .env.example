# Copia a `.env.local` para desarrollo. No subas secretos de producción.

# API pública (se incrusta en build si usas NEXT_PUBLIC_*)
NEXT_PUBLIC_API_URL=http://localhost:8095/api

# URL canónica del sitio (metadata, OG). Debe coincidir con FRONTEND_URL del API para enlaces en correos y back_urls MP.
# NEXT_PUBLIC_SITE_URL=https://jobshours.com

# Host principal (sin protocolo). El middleware de Next no reescribe rutas en este host; debe coincidir con PRIMARY_PUBLIC_HOST en Laravel.
# NEXT_PUBLIC_PRIMARY_HOST=jobshours.com

# Salud del runtime Next (monitor): GET /api/health

# Mercado Pago (opcional si el API ya expone MP_PUBLIC_KEY → GET /api/v1/payments/mp/brick-config)
# NEXT_PUBLIC_MP_PUBLIC_KEY=
# NEXT_PUBLIC_PAYMENT_GATEWAY=mercadopago
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=us2

# Reverb (WebSocket propio, protocolo Pusher). Si defines HOST + KEY, Echo usa Reverb y no el cluster Pusher Cloud.
# Deben coincidir con REVERB_APP_KEY y el host público donde Nginx proxea /app/ (mismo dominio que la web o API).
# NEXT_PUBLIC_REVERB_APP_KEY=
# NEXT_PUBLIC_REVERB_HOST=jobshours.com
# NEXT_PUBLIC_REVERB_PORT=443
# NEXT_PUBLIC_REVERB_SCHEME=https

# Opcional: URL absoluta del POST de auth de canales (por defecto /api/broadcasting/auth)
# NEXT_PUBLIC_ECHO_AUTH_ENDPOINT=https://jobshours.com/api/broadcasting/auth

# Analytics: POST de eventos (misma app: ruta API Routes)
NEXT_PUBLIC_ANALYTICS_INGEST=/api/jh-analytics

# Errores cliente (opcional). Sin DSN no se inicializa Sentry.
# NEXT_PUBLIC_SENTRY_DSN=

# Solo servidor Next: destinos de los rewrites (build-time). En el VPS, si API o inventario
# no están en estos puertos, definí antes de `npm run build`:
# INTERNAL_API_ORIGIN=http://127.0.0.1:8095
# INTERNAL_INVENTARIO_ORIGIN=http://127.0.0.1:8003
# INTERNAL_API_ORIGIN=https://jobshour-api
# INTERNAL_INVENTARIO_ORIGIN=http://10.0.0.2:8003

# Solo servidor Next: reenvío opcional al backend Laravel
# ANALYTICS_FORWARD_URL=https://tu-dominio.com/api/v1/analytics/events
# ANALYTICS_FORWARD_SECRET=
